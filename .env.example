# Copy this file to .env (git-ignored) and adjust as needed.
# Every value here has a working default -- .env is optional for local
# Ollama-backed development.

# --- LLM backend selection (CLAUDE.md rule 6) ---
# "ollama" (default, no-cost, local) or "anthropic" (paid API).
LLM_PROVIDER=ollama

# Used when LLM_PROVIDER=ollama.
# host.docker.internal is correct for Docker Desktop (Windows/Mac); on
# native Linux Docker Engine, docker-compose.yml's extra_hosts entry
# makes host.docker.internal resolve to the host too (Engine 20.10+).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# Used when LLM_PROVIDER=anthropic -- never commit a real key here.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Request limits (CLAUDE.md rules 9/10) ---
MAX_PROMPT_CHARS=4000
MAX_MODEL_SIZE_MM=250
REQUEST_TIMEOUT_SECONDS=60

# --- Suite integration (optional) ---
# Set automatically by launch.py -- override only if you know why.
# APP_HOST_PORT=8800
