PORT=4100

# Local Ollama server. host.docker.internal reaches services running on the
# host machine from inside the container (works on Docker Desktop; on Linux,
# docker-compose.yml adds the host-gateway mapping needed for this to work).
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
LOCAL_LLM_MODEL=llama3

# Render provider: local-sd (default, needs a local Stable Diffusion WebUI
# running with --api), meshy, or tripo (needs the matching API key below).
RENDER_PROVIDER=local-sd
SD_BASE_URL=http://host.docker.internal:7860

MESHY_API_KEY=
TRIPO_API_KEY=

OUTPUT_DIR=/app/output
