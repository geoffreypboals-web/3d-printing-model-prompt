# Project: 3D Printing Model Prompt
# File: /home/user/3d-printing-model-prompt/.env.example
# Description: Documented template of every environment variable the
#     service reads (see src/threedprompt/config.py). Copy to .env and
#     fill in as needed; .env itself is gitignored.
# Troubleshooting:
#     - Any value left unset falls back to the default shown here.

# --- LLM backend (rule 6: Ollama is the no-cost default) ---
LLM_PROVIDER=ollama
# OLLAMA_HOST depends on how you're running this service. Leave it
# commented for plain `docker compose up`: docker-compose.yml then points the
# app at the bundled ollama service (http://ollama:11434). Otherwise set ONE:
#   docker compose up --no-deps app, using the host's own Ollama:
# OLLAMA_HOST=http://host.docker.internal:11434
#   running locally without Docker:
# OLLAMA_HOST=http://localhost:11434
# (localhost inside a container is the container itself, never the host.)
#
# Must match a name in `ollama list` exactly, tag included (e.g. llama3.1:8b):
# a bare "llama3.1" only works if that exact tag was pulled.
OLLAMA_MODEL=llama3.1
# Only needed if LLM_PROVIDER=claude:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Raise (e.g. 600) when the Ollama GPU is shared with other long jobs --
# requests queue behind them.
LLM_TIMEOUT_SECONDS=60

# --- Classifier ---
# Heuristic confidence below this triggers an LLM fallback classification.
CLASSIFIER_CONFIDENCE_THRESHOLD=0.7

# --- External CAD tool binaries ---
OPENSCAD_BINARY=openscad
BLENDER_BINARY=blender
# freecad-python3's apt package installs the headless CLI as
# /usr/bin/freecadcmd, not /usr/bin/freecad - only used for wall-thickness
# on .stl input, STEP import/export, and solid healing; Blender remains
# the fallback/default for everything else if this is unset or missing.
FREECAD_BINARY=freecadcmd
CAD_SUBPROCESS_TIMEOUT_SECONDS=180

# --- Storage ---
OUTPUT_DIR=./output

# --- Request limits (rule 9/10) ---
MAX_PROMPT_LENGTH=2000
# 300MB - dense/scanned STL meshes routinely exceed the old 50MB default;
# raise further if you upload larger files (whole upload is buffered in
# memory before writing to disk, so keep this within your container's
# available RAM).
MAX_UPLOAD_BYTES=314572800
MAX_WALL_THICKNESS_MM=20.0
# Rejects a /mold request whose pour box or clamp shell would exceed this
# on its largest side (catches e.g. a clearance_mm typed in cm by mistake
# before it hangs a headless Blender boolean pass on a multi-meter box).
MAX_MOLD_DIMENSION_MM=300.0
# Caps the `size` (pixels) POST /thumbnail will render at.
THUMBNAIL_MAX_SIZE_PX=2048

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CACHE_ENABLED=true
